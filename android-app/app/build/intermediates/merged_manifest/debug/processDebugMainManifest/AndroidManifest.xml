<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tencent.mobileqq"
    android:versionCode="2599"
    android:versionName="9.0.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_op_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_op_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpLogin" >
        <activity
            android:name="com.dongpeng.oplogin.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.tencent.open.agent.AgentActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:process=":openSdk"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpLogin" >
        </activity>
    </application>

</manifest>